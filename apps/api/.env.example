# Copy to .env.local and fill in from Supabase: Project Settings > API Keys.

SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). Used for user-scoped requests.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Server only. Used to write steam_id after verification.
SUPABASE_SECRET_KEY=

# Public origin of the frontend. Auth redirects and the Steam OpenID realm use it.
APP_URL=http://localhost:3000
